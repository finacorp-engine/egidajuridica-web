---
interface Props {
  title?: string
  embedUrl?: string
}

const { title = 'Encuéntranos en', embedUrl = '' } = Astro.props
---

<section class="max-w-7xl mx-auto w-full px-0 sm:px-6 lg:px-8 py-24 md:py-32" aria-label="Ubicación de nuestra oficina">
  <div class="flex flex-col items-center mb-16">
    <h2 class="text-3xl md:text-4xl lg:text-5xl text-primary font-serif" data-animate="fade-up">
      {title}
    </h2>
  </div>
  {
    embedUrl && (
      <iframe
        src={embedUrl}
        class="w-full h-[1000px] grayscale transition-all duration-300 hover:grayscale-0"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        data-animate="map-reveal"
        title="Mapa de ubicación de Egida Jurídica"
        aria-label="Mapa interactivo de Google Maps con la ubicación de nuestra oficina"
      />
    )
  }
</section>
