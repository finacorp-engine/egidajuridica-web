---
import type { ExpertiseBullet, HeroButton } from '../../../lib/cms/types'

interface Props {
  title?: string
  description?: string
  bullets?: ExpertiseBullet[]
  imageSrc?: string
  imageAlt?: string
  cta?: HeroButton
}

const {
  title = 'Nuestra forma de ejercer el derecho',
  description = 'Trabajamos con un enfoque estratégico, transparente y orientado a resultados. Cada caso se analiza de forma individual, priorizando siempre la seguridad jurídica y los intereses del cliente.',
  bullets = [
    { label: 'Rigor jurídico', text: 'Análisis profundo y fundamentado de cada asunto.' },
    { label: 'Trato directo', text: 'Comunicación clara, sin tecnicismos innecesarios.' },
    { label: 'Estrategia personalizada', text: 'No usamos soluciones estándar para problemas distintos.' },
    { label: 'Compromiso profesional', text: 'Defendemos cada caso como si fuera propio.' },
  ],
  imageSrc = 'https://images.pexels.com/photos/8370959/pexels-photo-8370959.jpeg',
  imageAlt = 'Abogada trabajando en escritorio profesional',
  cta = { text: 'CONTÁCTANOS', href: '/contacto' },
} = Astro.props
---

<section class="w-full bg-background flex flex-col lg:flex-row" aria-label={title}>
  <div
    class="w-full lg:w-1/2 h-100 md:h-150 lg:h-250 min-h-50 lg:min-h-125"
    data-animate="slide-left"
    data-animate-duration="slow"
  >
    <img src={imageSrc} alt={imageAlt} class="w-full h-full object-cover" loading="lazy" />
  </div>

  <div class="w-full lg:w-1/2 flex py-12 md:py-16 lg:py-20 px-6 md:px-12 lg:px-20 xl:px-32 justify-center flex-col">
    <div class="max-w-152 w-full">
      <h2
        class="font-serif text-3xl sm:text-4xl md:text-[3.5rem] lg:text-[4.5rem] text-foreground leading-[1.05] tracking-tight mb-6 md:mb-8 font-normal"
        data-animate="fade-up"
      >
        {title}
      </h2>
      <div class="mb-8 md:mb-12" data-animate="fade-up" data-animate-delay="200">
        <p class="font-sans text-sm md:text-base text-muted-foreground leading-[1.8]">{description}</p>
        {
          bullets.length > 0 && (
            <ul class="mt-4 text-sm md:text-base text-muted-foreground list-disc pl-5 space-y-2" role="list">
              {bullets.map((bullet) => (
                <li>
                  <b class="font-medium">{bullet.label}:</b> {bullet.text}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        cta && (
          <a
            href={cta.href}
            class="inline-block px-6 py-3 md:px-8 md:py-3.5 border border-muted-foreground text-xs md:text-[13px] font-medium tracking-widest uppercase text-foreground hover:bg-foreground hover:text-background hover:border-foreground transition-colors duration-500"
            data-animate="fade-up"
            data-animate-delay="400"
          >
            {cta.text}
          </a>
        )
      }
    </div>
  </div>
</section>
