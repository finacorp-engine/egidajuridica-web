---
interface Props {
  heading?: string
  lastUpdated?: string
  intro?: string
  bodyHtml?: string
}

const {
  heading = 'Contenido legal',
  lastUpdated,
  intro,
  bodyHtml = '',
} = Astro.props

const formattedDate = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString('es-PE', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    })
  : null
---

<article
  class="pt-20 md:pt-32 pb-12 md:pb-16 px-4 sm:px-6 mx-auto max-w-3xl w-full content-section-animate"
  aria-label={heading}
>
  <h1 class="text-3xl sm:text-4xl md:text-5xl text-foreground font-serif font-medium mb-2 tracking-tighter">
    {heading}
  </h1>
  {
    formattedDate && (
      <p class="text-muted-foreground text-sm md:text-base mb-6 md:mb-8">
        Fecha de última actualización: {formattedDate}
      </p>
    )
  }
  {
    intro && (
      <p class="text-muted-foreground text-sm md:text-base mb-6 md:mb-8 leading-relaxed">{intro}</p>
    )
  }
  <div class="legal-content text-muted-foreground leading-relaxed" set:html={bodyHtml} />
</article>

<style>
  .legal-content :global(h2) {
    font-family: var(--font-serif, 'Times New Roman', serif);
    font-size: clamp(1.25rem, 2vw, 1.875rem);
    color: var(--color-foreground);
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .legal-content :global(h3) {
    font-family: var(--font-serif, 'Times New Roman', serif);
    font-size: 1.25rem;
    color: var(--color-foreground);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .legal-content :global(p) {
    margin-bottom: 1rem;
  }

  .legal-content :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
  }
</style>
