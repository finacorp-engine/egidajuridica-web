---
import type {
  CmsPage as CmsPageData,
  CmsSiteSettings,
  CmsNavigation,
} from '../../../lib/cms/types'
import { getFounder } from '../../../lib/cms/queries'
import { mapPageSeo } from '../../../lib/cms/mappers/seo'
import { mapNavItems } from '../../../lib/cms/mappers/links'
import { defaultFounderBlock } from '../../../lib/cms/mappers/blocks'
import BlockRenderer from '../block_renderer/index.astro'
import { Header, Footer } from '../index'
import { CoreLayout } from '../../../layouts'

interface Props {
  page: CmsPageData
  siteSettings: CmsSiteSettings
  navigation: CmsNavigation
}

const { page, siteSettings, navigation } = Astro.props

const seo = mapPageSeo(page, siteSettings)
const headerNav = mapNavItems(navigation.headerNavItems)
const footerNav = mapNavItems(navigation.footerNavItems)
const legalLinks = mapNavItems(navigation.legalLinks)

let layout = [...(page.layout ?? [])]
let founderBlock = layout.find((block) => block.blockType === 'founder') ?? null

// Mientras inicio no tenga el bloque "Sección Fundador" en el CMS, se usan los valores por defecto
if (!founderBlock && page.slug === 'home') founderBlock = defaultFounderBlock

// Si hay carrusel de equipo, el fundador va dentro de esa sección (versión clara)
// para no romper la alternancia negro/blanco; si no, se muestra como sección propia
const hasTeam = layout.some((block) => block.blockType === 'teamCarousel')
if (founderBlock && hasTeam) {
  layout = layout.filter((block) => block.blockType !== 'founder')
}

// Sin miembro elegido se usa al miembro cuyo cargo contiene "Fundador"
const needsFounderFallback =
  !!founderBlock && (!founderBlock.member || typeof founderBlock.member !== 'object')
const founderFallback = needsFounderFallback ? await getFounder() : null
---

<CoreLayout
  {...seo}
  site={siteSettings}
  showWhatsappButton={navigation.showWhatsappButton !== false}
  showUpButton={navigation.showUpButton !== false}
>
  <Header site={siteSettings} navLinks={headerNav} />
  <main id="main-content">
    {
      layout.map((block) => (
        <BlockRenderer
          block={block}
          site={siteSettings}
          founderFallback={founderFallback}
          founderBlock={hasTeam && block.blockType === 'teamCarousel' ? founderBlock : null}
        />
      ))
    }
  </main>
  <Footer site={siteSettings} footerNav={footerNav} legalLinks={legalLinks} />
</CoreLayout>
