---
import CmsPage from "../../components/shared/cms_page/index.astro";
import { getPageContext } from "../../lib/cms/queries";

const context = await getPageContext("acerca");
if (!context.page) return Astro.redirect("/404");
---

<CmsPage
  page={context.page}
  siteSettings={context.siteSettings}
  navigation={context.navigation}
/>
